{
  "name": "hoozit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "postbuild": "cp -r dist/hoozit/browser/en-US/assets dist/hoozit/browser/assets && cp -r dist/hoozit/browser/en-US/app-icons dist/hoozit/browser/app-icons && cp -r dist/hoozit/browser/en-US/media dist/hoozit/browser/media && rm -rf dist/hoozit/browser/*/assets dist/hoozit/browser/*/app-icons dist/hoozit/browser/*/media"
  },
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "dependencies": {
    "@angular/aria": "^22.2.4",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@types/leaflet": "^1.9.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
